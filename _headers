# Cloudflare Pages — HTTP headers
# เอกสาร: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# ไฟล์เกมเปลี่ยนบ่อยระหว่างพัฒนา — อย่า cache นาน
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# ระหว่างพัฒนา: ไม่ cache เพื่อให้เห็นการแก้ไขทันทีหลัง deploy
# เมื่อเกมนิ่งแล้วค่อยเปลี่ยนเป็น max-age=3600 เพื่อให้โหลดเร็วขึ้น
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=0, must-revalidate
